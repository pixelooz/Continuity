{{/* used when writing complete pages like the "base" imports nav, body, footer:
so here you would provide the "body", and the body of the base get's replaced
with whatever you provide */}}
{{template "base" .}}

{{define "main"}}
    <div class="container is-fullhd">
        <div class="title">Activity</div>
        <div class="tabs is-boxed">
            <ul>
                <li class="is-active"><a href="#">Recent Notes</a></li>
                <li><a href="#">Newest</a></li>
                <li><a href="#">Oldest</a></li>
            </ul>
        </div>
    </div>
{{end}}
