{{define "navbar"}}
    <nav class="navbar is-dark" role="navigation" aria-label="main navigation">
        <div class="navbar-brand">
            <a class="navbar-item" href="/v1/home">
                <img src="/static/img/brand-icon.svg" alt="went to buy milk">
            </a>
            <a role="button" class="navbar-burger" aria-label="menu" aria-expanded="true" data-target="nav-menu">
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
            </a>
        </div>

        <div id="nav-menu" class="navbar-menu">
            <div class="navbar-start">
                <a class="navbar-item" href="/v1/home">Home</a>
                <a class="navbar-item" href="/v1/collection">Collections</a>
                <a class="navbar-item" href="#">Metrics</a>
            </div>
            <div class="navbar-end">
                <div class="navbar-item">
                    <div class="dropdown is-right" x-data="{open: false}"
                         :class="{'is-active':open}"
                         @click.outside="open = false"
                    >
                        <div class="dropdown-trigger">
                            <button class="button is-dark" :class="{'is-active':open}"
                                    @click="open = !open"
                                    aria-haspopup="true"
                                    aria-controls="dropdown-menu"
                            >
                                <span>Settings</span>
                            </button>
                        </div>
                        <div class="dropdown-menu" id="dropdown-menu" role="menu">
                            <div class="dropdown-content">
                                <a href="#" class="dropdown-item">Advanced</a>
                                <form action="/user/logout" method="post" style="margin: 0; padding: 0;">
                                    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                                    <button type="submit" class="dropdown-item has-text-danger">Logout</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </nav>
{{end}}
